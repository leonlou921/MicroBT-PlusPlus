# Generic examples only. Keep actual configuration in the ignored .env file.
MICROBT_UMCTF_PYTHON=python3
MICROBT_DATASET_ID=1
MICROBT_DATASET_NAME=Dataset001_Example
nnUNet_raw=/path/to/nnUNet_raw
nnUNet_preprocessed=/path/to/nnUNet_preprocessed
MICROBT_PF_CACHE=/path/to/cache
CUDA_VISIBLE_DEVICES=0
# Evaluation aliases; set these to your own matching resource directories.
NNUNET_RAW_ROOT=/path/to/nnUNet_raw
NNUNET_PREPROCESSED_ROOT=/path/to/nnUNet_preprocessed
